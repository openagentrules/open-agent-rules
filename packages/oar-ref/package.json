{
  "name": "@openagentrules/oar-ref",
  "version": "1.1.0",
  "description": "Reference evaluator for Open Agent Rules 1.1. Zero runtime dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": { "oar-conformance": "./bin/oar-conformance.mjs" },
  "files": ["dist", "bin", "src"],
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "conformance": "npm run build && node bin/oar-conformance.mjs ../../spec/oar/1.1/conformance",
    "lint:pack": "npm run build && node bin/lint-pack.mjs ../../examples"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "typescript": "^5.7.2"
  }
}
