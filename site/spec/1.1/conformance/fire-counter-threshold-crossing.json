{
  "id": "fire-counter-threshold-crossing",
  "title": "The threshold on an engine counter lives in the rule, not in the engine",
  "covers": [
    "OAR-FIRE-3"
  ],
  "rule": [
    {
      "spec_version": "1.1",
      "id": "BREAKER_ESCALATED",
      "kind": "invariant",
      "on": "tool.pre_invoke",
      "selector": {},
      "effect": "block",
      "emit": "rule:conformance",
      "when": "breaker_count >= 3"
    },
    {
      "spec_version": "1.1",
      "id": "BREAKER_WARNING",
      "kind": "invariant",
      "on": "tool.pre_invoke",
      "selector": {},
      "effect": "nudge",
      "emit": "rule:conformance",
      "when": "breaker_count < 3"
    }
  ],
  "input": {
    "anchor": "tool.pre_invoke",
    "facts": {
      "tool": "read",
      "breaker_count": 3
    }
  },
  "expected": {
    "decision": "block",
    "code": "BREAKER_ESCALATED"
  }
}
